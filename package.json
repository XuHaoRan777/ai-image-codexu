{
  "name": "ai-image-codexu",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @ai-image-codexu/shared build && pnpm --parallel --filter @ai-image-codexu/web --filter @ai-image-codexu/api dev",
    "dev:web": "pnpm --filter @ai-image-codexu/shared build && pnpm --filter @ai-image-codexu/web dev",
    "dev:api": "pnpm --filter @ai-image-codexu/shared build && pnpm --filter @ai-image-codexu/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @ai-image-codexu/api test"
  }
}
